{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "excludeFiles": "{node_modules/**,public/images/**,public/fonts/**,storage/logs/**,storage/app/**,storage/framework/cache/data/**,tests/**,docs/**,*.md,vendor.zip,ruvector.db,.git/**,.github/**,.gstack/**,.claude/**,.codex/**,.superpowers/**}"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ]
}
